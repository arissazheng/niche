SOURCING_MODE=fixture
TASTE_MODE=fixture
APIFY_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
SOURCING_API_KEY=
DATABASE_PATH=data/sourcing.sqlite3
ACTOR_TIMEOUT_SECONDS=120
MAX_ACTOR_CHARGE_USD=0.50
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
UPLOAD_DIR=data/uploads
PUBLIC_API_URL=http://127.0.0.1:8000
# Stripe test-mode secret key (sk_test_...). Blank = checkout runs in fixture mode.
STRIPE_SECRET_KEY=
# Capital One Nessie mock bank: purchases are mirrored to this account when set.
NESSIE_API_KEY=
NESSIE_ACCOUNT_ID=
NESSIE_MERCHANT_ID=
# SpacetimeDB (live moodboard, build progress, streaming results). Token = the module publisher's identity:
# the `spacetimedb_token` value in ~/.config/spacetime/cli.toml after `npm run publish:local` in spacetime/.
SPACETIME_URL=
SPACETIME_DB=niche
SPACETIME_TOKEN=
