SOURCING_MODE=fixture
TASTE_MODE=fixture
APIFY_TOKEN=
# Claude key for the app. NICHE_ANTHROPIC_API_KEY also works and wins if both are set; use it where
# ANTHROPIC_API_KEY is reserved (Claude Code cloud sessions).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
SOURCING_API_KEY=
DATABASE_PATH=data/sourcing.sqlite3
ACTOR_TIMEOUT_SECONDS=120
MAX_ACTOR_CHARGE_USD=0.50
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
UPLOAD_DIR=data/uploads
PUBLIC_API_URL=http://127.0.0.1:8000
# Capital One Nessie mock bank. Link a profile to a demo account with: python -m finance.seed <profile_id>
NESSIE_API_KEY=
MAINSTREAM_ACTOR=zaarahemd/niche-mainstream
SECONDHAND_ACTOR=zaarahemd/niche-secondhand
# Our own Shopify actor (deploy with: python actors/deploy.py indie)
INDIE_ACTOR=zaarahemd/niche-indie
# Google Shopping costs $0.02/result on the free Apify plan: keep these low.
MAINSTREAM_QUERIES=1
MAINSTREAM_ITEMS_PER_QUERY=10

# SpacetimeDB (live moodboard, build progress, streaming results). Token = the module publisher's identity:
# the `spacetimedb_token` value in ~/.config/spacetime/cli.toml after `npm run publish:local` in spacetime/.
SPACETIME_URL=
SPACETIME_DB=niche
SPACETIME_TOKEN=

# Bright Data: Pinterest / Instagram lookbook imports (public pages only).
NICHE_BRIGHTDATA_API_KEY=
# Name of a Web Unlocker zone (Bright Data dashboard) for Pinterest *board* links; blank = profile links only.
BRIGHTDATA_UNLOCKER_ZONE=
# Name of a SERP API zone. With the Web Unlocker zone above, searches also find independent labels on any shop
# platform (Squarespace, WooCommerce, Big Cartel...) and read their product pages; blank = Shopify shops only.
BRIGHTDATA_SERP_ZONE=

# Cartesia: the assistant hears (speech-to-text) and talks back (text-to-speech) through the backend; the key stays here.
CARTESIA_API_KEY=

# Moss: semantic search over listings already shown, so the shop chat can recall "the green one from before".
# Optional: `pip install inferedge-moss` runs queries in memory; without it they go to Moss's cloud query API.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Gemini (Google AI Studio key, billing enabled): "Shops near you" via Grounding with Google Maps.
GEMINI_API_KEY=

# Snowflake (SQL API + Cortex REST): market price check. PAT = programmatic access token; the user needs a network policy.
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
