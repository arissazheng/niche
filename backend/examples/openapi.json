{
  "openapi": "3.1.0",
  "info": {
    "title": "Taste Sourcing API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/searches": {
      "post": {
        "summary": "Search",
        "operationId": "search_v1_searches_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/searches/{ident}": {
      "get": {
        "summary": "Get",
        "operationId": "get_v1_searches__ident__get",
        "parameters": [
          {
            "name": "ident",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ident"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/searches/{ident}/feedback": {
      "post": {
        "summary": "Feedback",
        "operationId": "feedback_v1_searches__ident__feedback_post",
        "parameters": [
          {
            "name": "ident",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ident"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Feedback"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Feedback": {
        "properties": {
          "listing_id": {
            "type": "string",
            "title": "Listing Id"
          },
          "liked": {
            "type": "boolean",
            "title": "Liked"
          },
          "comment": {
            "type": "string",
            "maxLength": 1000,
            "title": "Comment",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "listing_id",
          "liked"
        ],
        "title": "Feedback"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SearchRequest": {
        "properties": {
          "profile_version": {
            "type": "string",
            "title": "Profile Version",
            "default": "1"
          },
          "taste_profile": {
            "$ref": "#/components/schemas/TasteProfile"
          },
          "request": {
            "$ref": "#/components/schemas/ShoppingRequest"
          },
          "sources": {
            "items": {
              "type": "string",
              "enum": [
                "etsy",
                "depop",
                "poshmark",
                "grailed"
              ]
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Sources"
          },
          "limit": {
            "type": "integer",
            "maximum": 24.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 12
          },
          "candidates_per_source": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Candidates Per Source",
            "default": 30
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "taste_profile",
          "request"
        ],
        "title": "SearchRequest"
      },
      "ShoppingRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Query"
          },
          "max_item_price": {
            "type": "number",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Item Price"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "default": "USD"
          },
          "size": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ],
            "title": "Size"
          },
          "ship_to_country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "title": "Ship To Country",
            "default": "US"
          },
          "allow_secondhand": {
            "type": "boolean",
            "title": "Allow Secondhand",
            "default": true
          },
          "unknown_policy": {
            "type": "string",
            "enum": [
              "include_with_warning",
              "exclude"
            ],
            "title": "Unknown Policy",
            "default": "include_with_warning"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "max_item_price"
        ],
        "title": "ShoppingRequest"
      },
      "TasteProfile": {
        "properties": {
          "summary": {
            "type": "string",
            "maxLength": 3000,
            "title": "Summary"
          },
          "colors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Colors"
          },
          "silhouettes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Silhouettes"
          },
          "materials": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Materials"
          },
          "avoid": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Avoid"
          },
          "reference_image_urls": {
            "items": {
              "type": "string",
              "maxLength": 2083,
              "minLength": 1,
              "format": "uri"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Reference Image Urls"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "summary"
        ],
        "title": "TasteProfile"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}