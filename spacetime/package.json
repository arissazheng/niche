{
  "name": "niche-live",
  "private": true,
  "version": "0.1.0",
  "description": "SpacetimeDB module: live moodboard, build progress and streaming search results for Niche",
  "scripts": {
    "build": "spacetime build",
    "publish:local": "spacetime publish niche --server niche-local --yes",
    "generate": "spacetime generate --lang typescript --out-dir ../web/lib/spacetime --module-path ."
  },
  "dependencies": {
    "spacetimedb": "2.13.*"
  },
  "devDependencies": {
    "typescript": "~5.6.2"
  }
}
