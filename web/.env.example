NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_NAME=Niche
# Voice input provider. Cartesia speech-to-text (key lives in backend/.env as CARTESIA_API_KEY)
NEXT_PUBLIC_VOICE_PROVIDER=cartesia
# SpacetimeDB live state (local server from `spacetime start --listen-addr 127.0.0.1:3100`)
NEXT_PUBLIC_SPACETIMEDB_HOST=ws://127.0.0.1:3100
NEXT_PUBLIC_SPACETIMEDB_DB=niche
